%% Two views of the same pipeline. Mermaid renders natively on GitHub and in most
%% slide tools; paste into Excalidraw via: hamburger menu > Mermaid to Excalidraw.
%%
%% This file is the ONLY diagram source. A generated .excalidraw and its generator
%% used to sit beside it; all three drifted out of sync with the code, so the copies
%% were removed rather than maintained.

%% ---------------------------------------------------------------------------
%% 1. The simple view — what a non-technical reader needs
%% ---------------------------------------------------------------------------
flowchart LR
  R["Receipts<br/>photos, PDFs, text"] --> S["Employee<br/>prepares submission"]
  S --> H["submission.csv<br/>+ Google Sheet"]
  H --> F["Finance<br/>reviews against policy"]
  P["Company policy<br/>stored once"] --> F
  L["claims.csv<br/>what was paid before"] --> F
  F --> FR["finance-review.csv<br/>one decision per line"]
  FR --> OK["Approved lines<br/>-> claims.csv"]
  FR --> EX["Escalations<br/>-> a human decides"]
  FR --> RJ["Rejected lines<br/>-> stay here, not paid"]
  FR --> RP["Audit report<br/>a clause per decision"]

%% ---------------------------------------------------------------------------
%% 2. The detailed view — the two-lane pipeline
%% ---------------------------------------------------------------------------
flowchart TB
  subgraph EMP["EMPLOYEE — advisory only, never approves"]
    A["/expense-claim-review:expense-submit"] --> B{"Receipts given?"}
    B -->|No| C["Ask: photos, PDFs, or folder path"] --> D
    B -->|Yes| D["receipt-reader agent:<br/>date, vendor, description,<br/>category, price, currency, receipt_total"]
    D --> E["Self-check flags — optional<br/>LIKELY-* only, never a claimable amount"]
    E --> V1["validate_submission.py<br/>fix what you can; show 'Needed from you'"]
    V1 --> F["submission.csv — the only file"] --> G["Google Sheet:<br/>Expense Submission"]
  end

  subgraph FIN["FINANCE — the only side that may approve"]
    H["/expense-claim-review:expense-review"] --> I{"Policy configured?"}
    I -->|No| J["/expense-claim-review:setup-expense-policy<br/>attach the document or write the rules"] --> I
    I -->|Yes| K["Load ~/.expense-claim-review/policy.md<br/>+ meta.json UNSPECIFIED list"]
    K --> L["receipt-reader agent:<br/>re-read the original receipts<br/>verify; do not trust the submission"]
    L --> M["policy-checker agent:<br/>one verdict AND one decision per line<br/>WITHIN-POLICY / OVER-CAP / NON-REIMBURSABLE /<br/>NEEDS-APPROVAL / DUPLICATE / OUT-OF-WINDOW /<br/>MISSING-DATA / MISSING-RECEIPT / MANIFEST-MISMATCH<br/>-> APPROVE / REDUCE / REJECT / ESCALATE"]
    M --> N["claim-writer agent"]
    N --> FR["finance-review.csv<br/>source of truth, every line"]
    FR --> P["claims.csv<br/>derived: APPROVE + REDUCE"]
    FR --> Q["exceptions-queue.csv<br/>derived: ESCALATE"]
    FR --> O["EXPENSE_CLAIM_REVIEW.md<br/>summary block first"]
    FR --> V2["validate_review.py<br/>fix until it passes"]
    FR --> R["Google Sheet:<br/>Expense Review"]
    LED[("claims.csv<br/>prior claims")] -.->|"duplicate key:<br/>vendor + date + amount"| M
  end

  G -.->|"handoff: submission Sheet"| H
  R -.->|"outcome"| G

  subgraph HK["HOOKS — deterministic, outside the model's control"]
    S1["PreToolUse Write|Edit:<br/>block VIOLATION into claims.csv (exit 2)"]
    S2["PostToolUse Write|Edit:<br/>append to audit-log.txt"]
    S3["PreToolUse Agent:<br/>append to agent-invocations.log"]
  end
  S1 -.-> FR
  S2 -.-> FR
  S3 -.-> M

%% ---------------------------------------------------------------------------
%% 3. Agents — delegated on purpose since 0.3.0
%% ---------------------------------------------------------------------------
%% History matters here. In 0.2.0 the plugin declared four agents and the September
%% 2026 benchmark recorded ZERO Agent invocations across sixteen runs: the skills
%% ran every step inline. That lane was drawn dashed for exactly that reason.
%%
%% 0.3.0 makes delegation an instruction rather than an option — each skill names
%% the agent and says not to do the step inline — so the lane is drawn solid. The
%% evidence is agent-invocations.log, written by the PreToolUse hook on Agent (S3),
%% and golden-path.sh fails if it does not name all three finance-side agents.
%% If a future measurement shows the calls are not happening, redraw it dashed
%% again rather than leaving the diagram ahead of the facts.
flowchart LR
  SUBMIT["expense-submit"] --> AG1["receipt-reader"]
  REVIEW["expense-review"] --> AG1
  AG1 --> AG2["policy-checker"]
  AG2 --> AG3["claim-writer"]
  SET["setup-expense-policy"] --> AG4["policy-normalizer"]
  AG1 -.-> LOG[("agent-invocations.log")]
  AG2 -.-> LOG
  AG3 -.-> LOG
  AG4 -.-> LOG
